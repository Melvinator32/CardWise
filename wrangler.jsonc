{
  "name": "cardwise",
  "compatibility_date": "2026-09-01",

  // src/worker.js runs before every asset and requires the APP_PASSWORD secret.
  "main": "src/worker.js",

  // Keep variables set in the Cloudflare dashboard (APP_PASSWORD) across
  // deploys; without this, every `wrangler deploy` deletes them.
  "keep_vars": true,

  // Wrangler runs this before every deploy (and `wrangler dev`), so dist/ exists
  // however the deploy is started, Workers Builds included.
  "build": {
    "command": "mkdir -p dist && cp index.html _headers dist/"
  },

  // CardWise has no build step: the workflow copies index.html and _headers
  // into dist/ and Wrangler uploads that directory as static assets. Keeping a
  // dedicated directory means README.md, tools/ and .github/ are never served.
  "assets": {
    "directory": "./dist",
    // Every path serves index.html, so deep links into the dashboard work.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  }
}
